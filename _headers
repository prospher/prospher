# Cabecalhos servidos pela Cloudflare Pages.
# Referencia: checklist-producao-web.md secoes 20.1, 3.5 e 4.5.
# Conferir depois do deploy em https://securityheaders.com (meta: A).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # HSTS sem includeSubDomains ate o subdominio www existir e servir HTTPS.
  # Depois disso, trocar por: max-age=31536000; includeSubDomains
  # 'preload' so com o site estabilizado - e praticamente irreversivel.
  Strict-Transport-Security: max-age=31536000

# CSS e JS carregam com ?v=<hash> gerado pelo build: mudou o arquivo, muda a URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes tem nome estavel e praticamente nunca mudam.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Demais assets nao sao versionados no nome: cache longo, mas nao eterno.
/assets/*
  Cache-Control: public, max-age=2592000

# HTML sempre revalidado - correcao urgente nao pode ficar presa em cache.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/privacidade
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: no-store
